  "questions": [
    {
      "id": "q1",
      "type": "mcq",
      "category": "Triangles & Pythagoras Theorem",
      "marks": 2,
      "difficulty": "medium",
      "question": "In the right-angled triangle shown below, $AB = 6\\text{ cm}$ and $BC = 8\\text{ cm}$. What is the length of the hypotenuse $AC$?",
      "passageId": "",
      "tag": "Pythagoras Theorem",
      "hint": "Use $AC^2 = AB^2 + BC^2$",
      "asy": "size(200); draw((0,0)--(4,0)--(0,3)--cycle, black+1.2pt); label(\"B\", (0,0), SW); label(\"C\", (4,0), SE); label(\"A\", (0,3), NW); label(\"6 cm\", (0,1.5), W); label(\"8 cm\", (2,0), S); label(\"AC = ?\", (2,1.5), NE);",
      "options": [
        { "text": "10 cm", "explanation": "Correct. $AC = \\sqrt{6^2 + 8^2} = \\sqrt{36 + 64} = \\sqrt{100} = 10\\text{ cm}$." },
        { "text": "14 cm", "explanation": "14 cm is $6+8$, which is incorrect." },
        { "text": "12 cm", "explanation": "12 cm is incorrect." },
        { "text": "48 cm", "explanation": "48 is $6 \\times 8$, which is incorrect." }
      ],
      "correctIndex": 0,
      "correctAnswer": "10 cm",
      "explanation": "By Pythagoras theorem, $AC = \\sqrt{6^2 + 8^2} = \\sqrt{36 + 64} = 10\\text{ cm}$."
    },
    {
